# Palantir Foundry Configuration
# Copy this file to .env and fill in your actual values

# Your Foundry instance API URL
EXPO_PUBLIC_FOUNDRY_API_URL=https://newageplatform.usw-16.palantirfoundry.com

# Your Foundry Client ID
EXPO_PUBLIC_FOUNDRY_CLIENT_ID=9e0d5a99178a16cb02944b7d3910f13f

# Your Foundry Ontology RID
EXPO_PUBLIC_FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.999b797d-0f22-4d1a-9127-a804ab27568a

# OAuth Redirect URL (for development)
EXPO_PUBLIC_FOUNDRY_REDIRECT_URL=com.harmoni.familycalendar://auth/callback

# Your Foundry API Token (keep this secure!)
# Replace YOUR_FOUNDRY_TOKEN_HERE with your actual token from Foundry:
FOUNDRY_TOKEN=YOUR_FOUNDRY_TOKEN_HERE
